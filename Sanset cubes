-- АНИМАЦИЯ КУБИКА
------------------------------------------------------------
local function animateDie(dieData, duration, avail)
    local die = dieData.frame
    local dot = dieData.dot
    local stroke = dieData.stroke
    local shadow = dieData.shadow
    local shine = dieData.shine
    local elapsed = 0
    local bounce = 0.11
    local jump = 16

    while elapsed < duration do
        local c = colors[math.random(1, #colors)]
        TweenService:Create(die, TweenInfo.new(0.06), {BackgroundColor3 = c.color}):Play()
        TweenService:Create(shine, TweenInfo.new(0.06), {BackgroundTransparency = 0.6}):Play()

        local up = TweenService:Create(die, TweenInfo.new(bounce, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, -jump),
            Rotation = math.random(-12, 12),
        })
        TweenService:Create(shadow, TweenInfo.new(bounce), {
            Size = UDim2.new(0, DIE_SIZE - 18, 0, 3),
            BackgroundTransparency = 0.85,
        }):Play()
        up:Play()
        up.Completed:Wait()

        local down = TweenService:Create(die, TweenInfo.new(bounce, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 0, 0, 0),
            Rotation = 0,
        })
        TweenService:Create(shadow, TweenInfo.new(bounce), {
            Size = UDim2.new(0, DIE_SIZE - 10, 0, 4),
            BackgroundTransparency = 0.6,
        }):Play()
        down:Play()
        down.Completed:Wait()

        elapsed = elapsed + bounce * 2
    end

    local finalColor = avail[math.random(1, #avail)]
    TweenService:Create(die, TweenInfo.new(0.18), {
        BackgroundColor3 = finalColor.color,
        Position = UDim2.new(0, 0, 0, 0),
        Rotation = 0,
    }):Play()

    local pop = TweenService:Create(dot, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0.5, -7, 0.5, -7),
    })
    pop:Play()
    pop.Completed:Wait()
    TweenService:Create(dot, TweenInfo.new(0.2), {
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(0.5, -5, 0.5, -5),
    }):Play()

    TweenService:Create(stroke, TweenInfo.new(0.2), {Transparency = 0.05, Thickness = 2}):Play()
    task.wait(0.18)
    TweenService:Create(stroke, TweenInfo.new(0.3), {Transparency = 0.4, Thickness = 1.2}):Play()
end

