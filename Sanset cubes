local rolling = false

local function rollDice()
    if rolling then return end
    rolling = true
    rollBtn.Text = "ROLLING..."

    local avail = {}
    for _, c in ipairs(colors) do
        if not blocked[c.name] then
            table.insert(avail, c)
        end
    end

    if #avail == 0 then
        rollBtn.Text = "..."
        task.wait(0.5)
        rollBtn.Text = "ROLL"
        rolling = false
        return
    end

    local finished = 0
    for i = 1, 4 do
        local dur = 0.5 + (i - 1) * 0.22
        task.spawn(function()
            animateDie(dice[i], dur, avail)
            finished = finished + 1
        end)
    end
    while finished < 4 do
        task.wait(0.03)
    end

    rollBtn.Text = "ROLL"
    rolling = false
end

rollBtn.Activated:Connect(rollDice)
