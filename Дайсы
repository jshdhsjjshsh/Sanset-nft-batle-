-- АНИМАЦИЯ
------------------------------------------------------------
local function animateDie(dieData, avail)
    local die = dieData.frame
    local dot = dieData.dot
    local shadow = dieData.shadow
    local bounce = 0.12
    local jump = 16

    for _ = 1, 3 do
        local c = avail[math.random(1, #avail)]
        TweenService:Create(die, TweenInfo.new(0.06), {BackgroundColor3 = c.color}):Play()

        local up = TweenService:Create(die, TweenInfo.new(bounce, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 0, 0, -jump),
            Rotation = math.random(-12, 12),
        })
        TweenService:Create(shadow, TweenInfo.new(bounce), {
            Size = UDim2.new(0, DIE_SIZE - 18, 0, 3),
            BackgroundTransparency = 0.85,
        }):Play()
        up:Play()
        up.Completed:Wait()

        local down = TweenService:Create(die, TweenInfo.new(bounce, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 0, 0, 0),
            Rotation = 0,
        })
        TweenService:Create(shadow, TweenInfo.new(bounce), {
            Size = UDim2.new(0, DIE_SIZE - 10, 0, 4),
            BackgroundTransparency = 0.6,
        }):Play()
        down:Play()
        down.Completed:Wait()
    end

    local finalColor = avail[math.random(1, #avail)]
    TweenService:Create(die, TweenInfo.new(0.16), {
        BackgroundColor3 = finalColor.color,
        Position = UDim2.new(0, 0, 0, 0),
        Rotation = 0,
    }):Play()

    local pop = TweenService:Create(dot, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0.5, -7, 0.5, -7),
    })
    pop:Play()
    pop.Completed:Wait()
    TweenService:Create(dot, TweenInfo.new(0.18), {
        Size = UDim2.new(0, 10, 0, 10),
        Position = UDim2.new(0.5, -5, 0.5, -5),
    }):Play()
end

