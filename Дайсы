local rolling = false

local function rollDice()
    if rolling then return end
    rolling = true
    rollBtn.Text = "ROLLING..."

    local avail = {}
    for _, c in ipairs(colors) do
        if not colorBlocked[c.name] then
            table.insert(avail, c)
        end
    end

    if #avail == 0 then
        rollBtn.Text = "..."
        task.wait(0.5)
        rollBtn.Text = "ROLL"
        rolling = false
        return
    end

    for i = 1, 4 do
        animateDie(dice[i], avail)
        task.wait(0.06)
    end

    rollBtn.Text = "ROLL"
    rolling = false
end

rollBtn.Activated:Connect(rollDice)
